# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM (exercise generation) ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o

# --- ASR ---
# openai  -> OpenAI hosted Whisper (whisper-1), no local model download. Good for testing.
# local   -> faster-whisper large-v3 on-device. Better French WER, free, offline. Production default.
ASR_BACKEND=openai
ASR_OPENAI_MODEL=whisper-1
ASR_LOCAL_MODEL=large-v3
# auto | cpu | cuda   (Apple Silicon runs on cpu with int8; CTranslate2 has no MPS backend)
ASR_LOCAL_DEVICE=auto
ASR_LOCAL_COMPUTE_TYPE=int8

# --- storage ---
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/polyglot.sqlite

# --- api ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# Supabase
# ============================================================
# Nothing below is needed for local development — the defaults keep audio on disk
# and the library in SQLite.

# --- database ---
# Use the SESSION-MODE POOLER (port 5432 on the pooler host), NOT the direct
# connection: direct connections are IPv6-only, and transaction mode (6543) breaks
# SQLAlchemy's prepared statements. Copy it from
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI,
# then swap the driver prefix to postgresql+psycopg.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- object storage ---
# local | supabase
STORAGE_BACKEND=local
# SUPABASE_URL=https://<project-ref>.supabase.co
# service_role key from Project Settings -> API. It BYPASSES Row Level Security, so it
# is server-side only and must never reach the frontend bundle.
# SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=audio
# How long a playback URL stays valid. Long enough for a listening session, short
# enough that a copied link stops working.
SIGNED_URL_TTL_S=3600

# ============================================================
# Accounts (Supabase Auth)
# ============================================================
# Sign-in stays OFF until both SUPABASE_URL (above) and SUPABASE_ANON_KEY are set. With them
# absent the app runs perfectly well anonymous-only: everyone gets the FREE_UNIT_LIMIT below,
# word lookup and the saved-words book work, and the masthead simply shows no "Sign in".
#
# The anon key is the PUBLISHABLE key — Project Settings -> API -> anon/public (newer projects
# call it "publishable", sb_publishable_...). Unlike SUPABASE_SERVICE_KEY it does not bypass Row
# Level Security and is meant to ship to browsers; the API serves it to the frontend from
# GET /api/auth/config so the project URL is configured in this file only.
#
# There is deliberately NO jwt secret here. This project signs access tokens with ES256 and
# publishes the verifying public key at {SUPABASE_URL}/auth/v1/.well-known/jwks.json, so the
# backend validates them offline and adding accounts introduced no new secret.
# SUPABASE_ANON_KEY=

# Listening units a learner may open, per tier. Premium is unlimited and has no setting.
FREE_UNIT_LIMIT=2
MEMBER_UNIT_LIMIT=5

# ============================================================
# Billing (Stripe)  — optional
# ============================================================
# All three absent by default; /api/billing/* then answers 503 and the upgrade button is hidden.
# Everything else, including the two- and five-recording tiers, works without a Stripe account.
#
# Card details never reach this application: the browser is redirected to Stripe-hosted Checkout,
# so there is no Stripe.js in the bundle and no card field in our HTML.
# STRIPE_SECRET_KEY=sk_test_...
# The recurring price the subscription is for (Product -> Pricing -> API ID, price_...).
# STRIPE_PRICE_ID=price_...
# Signing secret for the webhook endpoint. THE WEBHOOK IS THE ONLY THING THAT GRANTS PREMIUM,
# and it refuses to process anything unless this is set — without it there is no way to tell a
# real Stripe delivery from anyone who has read the source. Get it from
# Stripe -> Developers -> Webhooks -> your endpoint (POST /api/billing/webhook), or for local
# testing from:  stripe listen --forward-to localhost:8000/api/billing/webhook
# Subscribe the endpoint to: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid
# STRIPE_WEBHOOK_SECRET=whsec_...

# Where Stripe returns the learner, and the base for confirmation links.
APP_BASE_URL=http://localhost:5173
