# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM (exercise generation) ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o

# --- ASR ---
# openai  -> OpenAI hosted Whisper (whisper-1), no local model download. Good for testing.
# local   -> faster-whisper large-v3 on-device. Better French WER, free, offline. Production default.
ASR_BACKEND=openai
ASR_OPENAI_MODEL=whisper-1
ASR_LOCAL_MODEL=large-v3
# auto | cpu | cuda   (Apple Silicon runs on cpu with int8; CTranslate2 has no MPS backend)
ASR_LOCAL_DEVICE=auto
ASR_LOCAL_COMPUTE_TYPE=int8

# --- storage ---
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/polyglot.sqlite

# --- api ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
