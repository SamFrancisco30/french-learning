# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM (exercise generation) ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o

# --- ASR ---
# openai  -> OpenAI hosted Whisper (whisper-1), no local model download. Good for testing.
# local   -> faster-whisper large-v3 on-device. Better French WER, free, offline. Production default.
ASR_BACKEND=openai
ASR_OPENAI_MODEL=whisper-1
ASR_LOCAL_MODEL=large-v3
# auto | cpu | cuda   (Apple Silicon runs on cpu with int8; CTranslate2 has no MPS backend)
ASR_LOCAL_DEVICE=auto
ASR_LOCAL_COMPUTE_TYPE=int8

# --- storage ---
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/polyglot.sqlite

# --- api ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# Supabase
# ============================================================
# Nothing below is needed for local development — the defaults keep audio on disk
# and the library in SQLite.

# --- database ---
# Use the SESSION-MODE POOLER (port 5432 on the pooler host), NOT the direct
# connection: direct connections are IPv6-only, and transaction mode (6543) breaks
# SQLAlchemy's prepared statements. Copy it from
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI,
# then swap the driver prefix to postgresql+psycopg.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- object storage ---
# local | supabase
STORAGE_BACKEND=local
# SUPABASE_URL=https://<project-ref>.supabase.co
# service_role key from Project Settings -> API. It BYPASSES Row Level Security, so it
# is server-side only and must never reach the frontend bundle.
# SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=audio
# How long a playback URL stays valid. Long enough for a listening session, short
# enough that a copied link stops working.
SIGNED_URL_TTL_S=3600
