# --- secrets ---
.env
.env.*
!.env.example

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- data / generated media (never commit downloaded audio) ---
backend/data/
!backend/data/.gitkeep
*.wav

# ...except the spoken-punctuation clips, which are deliberately committed assets rather than
# downloaded media. `*.wav` above was written for ingested audio and caught these too, so the
# dictée's punctuation announcements existed only on the machine that rendered them: anywhere else
# _load_assets raises MissingAssets and the feature is simply unavailable. They are twelve short
# words, 660KB, and never change.
!backend/app/media/assets/punctuation/**/*.wav
*.m4a
*.mp3
*.webm
*.opus

# --- node ---
node_modules/
dist/
.vite/
coverage/
*.tsbuildinfo

# --- db ---
*.sqlite
*.sqlite3
*.db

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# scratch dir for the topic photo pipeline (downloads + contact sheets)
frontend/.topic-photos/

# --- isolated implementation worktrees ---
.worktrees/
.tmp/
